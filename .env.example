# These values are for running Compose manually. Jenkins supplies them automatically.
SERVICE=go-backend
GO_SOURCE_DIR=/absolute/path/to/go-application
GO_DOCKERFILE=/absolute/path/to/deployment-toolkit/docker/go.Dockerfile
GO_BUILD_PACKAGE=./cmd/server
GO_VERSION=1.25
GO_IMAGE_REPOSITORY=local/go-backend
GO_HOST_PORT=8081
GO_CONTAINER_PORT=8080
GO_RESTART_POLICY=unless-stopped
GO_MEMORY_LIMIT=256m
GO_CPU_LIMIT=0.50
REACT_SOURCE_DIR=/absolute/path/to/react-application
REACT_DOCKERFILE=/absolute/path/to/deployment-toolkit/docker/react.Dockerfile
NODE_VERSION=22
NODE_BUILD_MEMORY_MB=768
REACT_IMAGE_REPOSITORY=local/react-frontend
REACT_HOST_PORT=3000
REACT_CONTAINER_PORT=80
REACT_RESTART_POLICY=unless-stopped
REACT_MEMORY_LIMIT=256m
REACT_CPU_LIMIT=0.50
RUBY_SOURCE_DIR=/absolute/path/to/ruby-application
RUBY_DOCKERFILE=/absolute/path/to/deployment-toolkit/docker/ruby.Dockerfile
RUBY_VERSION=3.4.5
RUBY_IMAGE_REPOSITORY=local/ruby-service
RUBY_HOST_PORT=9292
RUBY_CONTAINER_PORT=9292
RUBY_RESTART_POLICY=unless-stopped
RUBY_MEMORY_LIMIT=256m
RUBY_CPU_LIMIT=0.50
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
RELEASE_RETENTION=5
IMAGE_RETENTION_HOURS=72
PRUNE_BUILD_CACHE=true
BUILD_CACHE_RETENTION_HOURS=168
TARGET_IMAGE_REPOSITORY=local/go-backend
IMAGE_TAG=manual-test
APP_ENV=dev
COMPOSE_PROJECT_NAME=deployment-dev
